---
pagination:
  data: i18n.langs
  size: 1
  alias: t
permalink: "{{ t.url }}play/index.html"
eleventyExcludeFromCollections: true
---
{% assign p = plaza[t.lang] %}
{% assign d = dialogue[t.lang] %}
<!doctype html>
<html lang="{{ t.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ p.title }} - {{ site.name }}</title>
<link rel="stylesheet" href="{{ p.root }}assets/plaza.css">
<link rel="icon" href="{{ p.root }}assets/ball.svg" type="image/svg+xml">
<script type="module" src="{{ p.root }}assets/plaza-entry.js"></script>
</head>
<body>
<header>
  <a id="portfolio" href="../">{{ p.portfolio }} ↗</a>
  <span>{{ site.name }}</span>
  <a href="{{ p.other }}" lang="{{ p.otherLang }}" hreflang="{{ p.otherLang }}">{{ p.otherName }}</a>
</header>
<main aria-label="{{ p.title }}">
  <div class="stage">
    <details class="menu" open>
      <summary><h1>{{ p.title }}</h1></summary>
      <p class="eyebrow">{{ p.preview }}</p>
      <p>{{ p.intro }}</p>
      <div id="how" hidden>
        <p>{{ p.instructions }}</p>
        <p class="note">{{ p.touch }}</p>
      </div>
      <p class="note">{{ p.note }}</p>
      <button id="enter" hidden>{{ p.enter }}</button>
      <p id="loading" role="status" data-loading="{{ p.loading }}" data-error="{{ p.error }}"></p>
      <nav aria-label="{{ p.directory }}">
        <h2>{{ p.directory }}</h2>
        <div id="directory-actions" hidden>
          <button data-action="lamp" aria-pressed="false">{{ p.lamp }}</button>
          <button data-action="pond">{{ p.pond }}</button>
          <button data-action="university">{{ p.university }} · {{ university.name }}</button>
          <button data-action="study">{{ p.study }}</button>
          <button data-action="paper">{{ p.paper }}</button>
          <button data-action="studyLamp" aria-pressed="true">{{ p.studyLamp }}</button>
          <button data-action="light" aria-pressed="true">{{ p.light }}</button>
          <button data-action="notebook" data-item-name="{{ p.notebookName }}">{{ p.notebook }}</button>
          <button data-action="sensor" data-item-name="{{ p.sensorName }}">{{ p.sensor }}</button>
          <button data-action="robot">{{ p.robot }}</button>
          <button data-action="welding">{{ p.welding }}</button>
          <button data-action="tools">{{ p.tools }}</button>
          <button data-action="parts">{{ p.parts }}</button>
          <button data-action="computer">{{ p.computer }}</button>
          <button data-action="board">{{ p.board }}</button>
          <button data-action="inventory">{{ p.inventory }} (<span id="inventory-count">0</span>)</button>
        </div>
        <div id="directory-places" hidden>
          <h2>{{ p.places }}</h2>
          <button data-travel="plaza">{{ p.plaza }}</button>
          <button data-travel="outside">{{ p.outside }}</button>
          <button data-travel="study">{{ p.study }}</button>
        </div>
        <a href="../">{{ p.about }}</a>
        <a href="../#open-source">{{ t.os_h }} / {{ t.own_h }}</a>
        <a href="../#skills">{{ t.skills_h }}</a>
        <a href="../#quests">{{ t.quests_h }}</a>
        <a href="{{ p.root }}posts/">{{ t.journal_h }}</a>
        <details id="transcripts">
          <summary>{{ d.transcript }}</summary>
          {% for conversation in d.lines %}
          <section data-transcript="{{ conversation[0] }}">
            <h3>{{ p[conversation[0]] }}</h3>
            {% for line in conversation[1] %}<p>{{ line | escape }}</p>{% endfor %}
          </section>
          {% endfor %}
          <p>{{ university.name }} · {{ university.dates }} · {{ t.q_ufsc_t }}</p>
          <p id="degree">{{ university.degree[t.lang] }}</p>
        </details>
      </nav>
    </details>
    <section id="board-surface" aria-label="{{ p.board }}" hidden>
      <p id="board-equation"></p>
      <div id="board-choices"><button></button><button></button><button></button></div>
    </section>
    <div id="playable" hidden>
      <p id="instructions" class="sr-only">{{ p.instructions }}</p>
      <div id="plaza" role="group" aria-label="{{ p.map }}" aria-describedby="instructions"></div>
    </div>
  </div>
  <p id="fallback">{{ p.fallback }} <a href="../">{{ p.portfolio }}</a></p>
  <div id="controls" hidden>
    <p id="location" role="status" aria-label="{{ p.location }}"></p>
    <p id="nearby" role="status" data-near="{{ p.near }}" data-far="{{ p.far }}">{{ p.far }}</p>
    <button id="interact" data-speech="{{ d.action }}" disabled>{{ p.open }}</button>
    <button id="run" aria-pressed="false">{{ p.run }}</button>
    <div class="pad" role="group" aria-label="{{ p.touch }}">
      <button data-direction="left" aria-label="{{ p.left }}">←</button>
      <button data-direction="up" aria-label="{{ p.up }}">↑</button>
      <button data-direction="down" aria-label="{{ p.down }}">↓</button>
      <button data-direction="right" aria-label="{{ p.right }}">→</button>
    </div>
  </div>
  <section id="experiment" aria-labelledby="challenge-title" hidden>
    <h2 id="challenge-title" tabindex="-1"></h2>
    <p id="challenge-result" role="status" aria-live="polite" aria-atomic="true"></p>
    <p id="challenge-help"></p>
    <div class="experiment-controls">
      <button data-adjust="left" aria-label="{{ d.previousPosition }}">←</button>
      <button data-adjust="right" aria-label="{{ d.nextPosition }}">→</button>
      <button id="challenge-action"></button>
      <button id="challenge-again" hidden>{{ d.again }}</button>
      <button id="challenge-leave">{{ d.finish }}</button>
      <span id="challenge-progress"></span>
    </div>
  </section>
</main>
<dialog aria-labelledby="panel-title" aria-describedby="speech-readable interaction-result">
  <p id="panel-context" class="eyebrow"></p>
  <h2 id="panel-title" tabindex="-1">Tiago</h2>
  <p id="speech" aria-hidden="true"><span id="speech-space"></span><span id="speech-typed"></span></p>
  <p id="speech-readable" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
  <p id="interaction-result" class="note"></p>
  <section data-panel="inventory" hidden>
    <p>{{ p.session }}</p>
    <p id="empty-inventory">{{ p.empty }}</p>
    <ul id="inventory"></ul>
  </section>
  <p id="speech-hint" class="note">{{ d.hint }}</p>
</dialog>
  <span id="challenge-labels" hidden data-finished="{{ d.finished }}" data-finish="{{ d.finish }}" data-select="{{ d.select }}" data-input="{{ p.input }}" data-progress="{{ d.progress }}" data-of="{{ d.of }}"{% assign kinds = "board,robot" | split: "," %}{% for kind in kinds %}{% for item in d[kind] %} data-{{ kind }}-{{ item[0] }}="{{ item[1] | escape }}"{% endfor %}{% endfor %}></span>
<p id="pickup-status" class="sr-only" role="status"></p>
<div id="messages" hidden data-study-lamp-on="{{ p.studyLampOn }}" data-study-lamp-off="{{ p.studyLampOff }}" data-lights-on="{{ p.lightsOn }}" data-lights-off="{{ p.lightsOff }}" data-lamp-on="{{ p.lampOn }}" data-lamp-off="{{ p.lampOff }}" data-pond-jump="{{ p.pondJump }}" data-picked="{{ p.picked }}" data-already-picked="{{ p.alreadyPicked }}"></div>
</body>
</html>
