---
pagination:
  data: i18n.langs
  size: 1
  alias: t
permalink: "{{ t.url }}play/index.html"
eleventyExcludeFromCollections: true
---
{% assign p = plaza[t.lang] %}
<!doctype html>
<html lang="{{ t.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ p.title }} - {{ site.name }}</title>
<link rel="stylesheet" href="{{ p.root }}assets/plaza.css">
<link rel="icon" href="{{ p.root }}assets/ball.svg" type="image/svg+xml">
<script type="module" src="{{ p.root }}assets/plaza-entry.js"></script>
</head>
<body>
<header>
  <a id="portfolio" href="../">{{ p.portfolio }} ↗</a>
  <span>{{ site.name }}</span>
  <a href="{{ p.other }}" lang="{{ p.otherLang }}" hreflang="{{ p.otherLang }}">{{ p.otherName }}</a>
</header>
<main aria-label="{{ p.title }}">
  <div class="stage">
    <details class="menu" open>
      <summary><h1>{{ p.title }}</h1></summary>
      <p class="eyebrow">{{ p.preview }}</p>
      <p>{{ p.intro }}</p>
      <div id="how" hidden>
        <p>{{ p.instructions }}</p>
        <p class="note">{{ p.touch }}</p>
      </div>
      <p class="note">{{ p.note }}</p>
      <button id="enter" hidden>{{ p.enter }}</button>
      <p id="loading" role="status" data-loading="{{ p.loading }}" data-error="{{ p.error }}"></p>
      <nav aria-label="{{ p.directory }}">
        <h2>{{ p.directory }}</h2>
        <div id="directory-actions" hidden>
          <button data-action="university">{{ p.university }} · {{ university.name }}</button>
          <button data-action="paper">{{ p.paper }}</button>
          <button data-action="light" aria-pressed="true">{{ p.light }}</button>
          <button data-action="notebook" data-item-name="{{ p.notebookName }}">{{ p.notebook }}</button>
          <button data-action="sensor" data-item-name="{{ p.sensorName }}">{{ p.sensor }}</button>
          <button data-action="robot">{{ p.robot }}</button>
          <button data-action="computer">{{ p.computer }}</button>
          <button data-action="board">{{ p.board }}</button>
          <button data-action="inventory">{{ p.inventory }} (<span id="inventory-count">0</span>)</button>
        </div>
        <div id="directory-places" hidden>
          <h2>{{ p.places }}</h2>
          <button data-travel="plaza">{{ p.plaza }}</button>
          <button data-travel="outside">{{ p.outside }}</button>
          <button data-travel="study">{{ p.study }}</button>
        </div>
        <a href="../">{{ p.about }}</a>
        <a href="../#open-source">{{ t.os_h }} / {{ t.own_h }}</a>
        <a href="../#skills">{{ t.skills_h }}</a>
        <a href="../#quests">{{ t.quests_h }}</a>
        <a href="{{ p.root }}posts/">{{ t.journal_h }}</a>
      </nav>
    </details>
    <div id="playable" hidden>
      <p id="instructions" class="sr-only">{{ p.instructions }}</p>
      <div id="plaza" role="group" aria-label="{{ p.map }}" aria-describedby="instructions"></div>
    </div>
    <p id="feedback" role="status"></p>
  </div>
  <p id="fallback">{{ p.fallback }} <a href="../">{{ p.portfolio }}</a></p>
  <div id="controls" hidden>
    <p id="location" aria-label="{{ p.location }}"></p>
    <p id="nearby" role="status" data-near="{{ p.near }}" data-far="{{ p.far }}">{{ p.far }}</p>
    <button id="interact" disabled>{{ p.open }}</button>
    <div class="pad" role="group" aria-label="{{ p.touch }}">
      <button data-direction="left" aria-label="{{ p.left }}">←</button>
      <button data-direction="up" aria-label="{{ p.up }}">↑</button>
      <button data-direction="down" aria-label="{{ p.down }}">↓</button>
      <button data-direction="right" aria-label="{{ p.right }}">→</button>
    </div>
  </div>
</main>
<dialog aria-labelledby="panel-title">
  <h2 id="panel-title" tabindex="-1"></h2>
  <section data-panel="university" hidden>
  <p class="eyebrow">{{ p.university }} · {{ university.dates }}</p>
  <h3>{{ university.name }}</h3>
  <p>{{ t.q_ufsc_t }}</p>
  <p id="degree">{{ university.degree[t.lang] }}</p>
  </section>
  <section data-panel="paper" hidden>
    <p class="eyebrow">{{ p.paperTitle }} · {{ university.name }}</p>
    <p>{{ university.dates }}</p>
    <p>{{ university.degree[t.lang] }}</p>
    <p><strong>{{ t.s3n }}</strong> {{ t.s3 }}</p>
  </section>
  <section data-panel="inventory" hidden>
    <p>{{ p.session }}</p>
    <p id="empty-inventory">{{ p.empty }}</p>
    <ul id="inventory"></ul>
  </section>
  <section data-panel="robot" hidden>
    <p>{{ p.robotText }}</p>
    <button id="robot-toggle" aria-pressed="false">{{ p.robotToggle }}</button>
    <p id="robot-status" role="status" data-open="{{ p.robotOpen }}" data-closed="{{ p.robotClosed }}">{{ p.robotOpen }}</p>
  </section>
  <section data-panel="computer" hidden>
    <p>{{ p.computerText }}</p>
    <button id="computer-toggle" aria-expanded="false" aria-controls="terminal">{{ p.computerToggle }}</button>
    <div id="terminal" hidden><p><strong>{{ t.s1n }}</strong></p><p>{{ t.s1 }}</p></div>
  </section>
  <section data-panel="board" hidden>
    <p>{{ p.boardText }}</p>
    <p class="calculation" role="status"><span>{{ p.input }}: <b id="board-input">0</b></span><span> + 1 → </span><span>{{ p.output }}: <b id="board-output">1</b></span></p>
    <button id="board-next">{{ p.boardNext }}</button>
  </section>
  <form method="dialog"><button>{{ p.close }}</button></form>
</dialog>
<div id="messages" hidden data-lights-on="{{ p.lightsOn }}" data-lights-off="{{ p.lightsOff }}" data-picked="{{ p.picked }}" data-already-picked="{{ p.alreadyPicked }}"></div>
</body>
</html>
